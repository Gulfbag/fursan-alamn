# خادم Node يستمع افتراضياً إلى 8080؛ Cloud Run يمرر PORT بنفسه.
PORT=8080

# التعطيل هو الوضع الآمن الافتراضي. لا ينجح POST /api/leads عند التعطيل.
LEAD_SINK=disabled

# عند اعتماد الربط فقط: origin كامل بلا مسار، وهو إلزامي لمنع Origin غير مطابق.
# APP_ORIGIN=https://www.example.sa

# عند اعتماد مخطط Google Sheets وتبويب Website_Leads فقط:
# LEAD_SINK=sheets
# FURSAN_SPREADSHEET_ID=replace-after-approval
# FURSAN_LEADS_SHEET=Website_Leads
# FURSAN_CONSENT_VERSION=2026-10-privacy-v1

# حد داخل instance واحد فقط، وليس حماية موزعة بين نسخ Cloud Run.
LEAD_RATE_LIMIT=8
LEAD_RATE_WINDOW_MS=60000

# لا تضف GOOGLE_APPLICATION_CREDENTIALS أو مفتاح Service Account JSON هنا.
# تستخدم الخدمة ADC/هوية وقت التشغيل بعد اعتماد الصلاحيات.
