# خادم Node يستمع افتراضياً إلى 8080؛ Cloud Run يمرر PORT بنفسه.
PORT=8080

# production هو الافتراضي؛ staging مسموح لكن لا يسمح بتوجيه Sheets مباشر.
APP_ENV=production

# التعطيل هو الوضع الآمن الافتراضي. لا ينجح POST /api/leads عند التعطيل.
LEAD_SINK=disabled

# APP_ORIGIN خادمي فقط وإلزامي في وضعي sheets وbridge؛ بلا مسار أو query.
# APP_ORIGIN=https://www.example.sa

# production فقط: عند اعتماد مخطط Google Sheets وتبويب Website_Leads فقط:
# LEAD_SINK=sheets
# FURSAN_SPREADSHEET_ID=
# FURSAN_LEADS_SHEET=Website_Leads

# staging أو production: يرسل website إلى Cloud Run receiver خاص فقط.
# origin وaudience أصلان Cloud Run قانونيان ومتطابقان، والقائمة CSV دقيقة وتتضمن origin.
# LEAD_SINK=bridge
# BRIDGE_ORIGIN=
# BRIDGE_AUDIENCE=
# BRIDGE_ALLOWED_ORIGINS=

# إصدار الموافقة الحالي المشترك بين website وreceiver.
# FURSAN_CONSENT_VERSION=2026-10-privacy-v1

# متغيرات receiver فقط عند تشغيل نفس الصورة بالأمر:
# node server/integration/receiver-index.mjs
# لا تفعّله إلا في staging؛ يعيد receiver المعطل 503 لمسار الإدخال.
# BRIDGE_RECEIVER_ENABLED=false
# FURSAN_STAGING_SPREADSHEET_ID=
# FURSAN_STAGING_LEADS_SHEET=Website_Leads
# BRIDGE_ALLOWED_CALLERS=
# FURSAN_MASTER_SYNC=disabled

# حد داخل instance واحد فقط، وليس حماية موزعة بين نسخ Cloud Run.
LEAD_RATE_LIMIT=8
LEAD_RATE_WINDOW_MS=60000

# لا تضف GOOGLE_APPLICATION_CREDENTIALS أو مفتاح Service Account JSON هنا.
# تستخدم الخدمة ADC/هوية وقت التشغيل بعد اعتماد الصلاحيات.
